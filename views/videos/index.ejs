<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Videos - OLYMP Streaming</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="page-wrapper">
    <%- include('../partials/flash') %>

    <section class="videos-container">
      <div class="videos-header">
        <div>
          <p class="videos-kicker">Chaine YouTube OLYMP</p>
          <h2>Lives & videos OLYMP</h2>
          <p>Retrouve les directs, replays, debats et documentaires publies sur notre chaine.</p>
        </div>
        <% if (typeof channelUrl !== 'undefined' && channelUrl) { %>
          <a class="btn btn-primary" href="<%= channelUrl %>" target="_blank" rel="noopener">Voir la chaine YouTube</a>
        <% } %>
      </div>

      <% if (typeof youtubeError !== 'undefined' && youtubeError) { %>
        <div class="alert-error">Impossible de charger les videos YouTube pour l'instant. Verifie la configuration de la chaine.</div>
      <% } %>

      <section class="live-feature">
        <% if (typeof liveVideo !== 'undefined' && liveVideo) { %>
          <a href="/videos/<%= liveVideo.id %>" class="live-feature-card">
            <div class="live-feature-media" style="background-image:url('<%= liveVideo.thumbnailUrl %>')">
              <span class="live-badge">EN DIRECT</span>
              <span class="live-play">&#9658;</span>
            </div>
            <div class="live-feature-info">
              <p class="videos-kicker">Live maintenant</p>
              <h3><%= liveVideo.title %></h3>
              <p><%= liveVideo.description || "Le direct YouTube est disponible sur OLYMP." %></p>
            </div>
          </a>
        <% } else { %>
          <div class="live-feature-empty">
            <p class="videos-kicker">Live</p>
            <h3>Aucun direct en cours</h3>
            <p>Quand une video est diffusee en live sur la chaine YouTube, elle apparaitra ici en priorite.</p>
          </div>
        <% } %>
      </section>

      <div class="videos-grid">
        <% if (videos.length === 0) { %>
          <p>Aucune video YouTube a afficher pour le moment.</p>
        <% } %>

        <% videos.forEach(video => { %>
          <a href="/videos/<%= video.id %>" class="video-card">
            <div class="video-thumb" style="background-image:url('<%= video?.thumbnailUrl %>')">
              <% if (video.isLive) { %>
                <span class="live-badge">EN DIRECT</span>
              <% } %>
              <div class="thumb-logo">
                <img src="/images/logo_olymp_blanc.png" alt="OLYMP Digital Media">
              </div>
            </div>
            <div class="video-info">
              <h3><%= video.title %></h3>
              <p><%= video.description || "" %></p>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
  </main>
</body>
</html>
